# ---------------------------------------------------------------------------
# Aurelia environment configuration. Copy to `.env` and fill in.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL (docker-compose provides this default locally).
DATABASE_URL=postgresql://aurelia:aurelia@localhost:5432/aurelia?schema=public

# --- Security ---------------------------------------------------------------
# JWT signing secret for short-lived access tokens (>= 32 chars).
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=900               # seconds (15 minutes)
REFRESH_TOKEN_TTL_DAYS=30

# 32-byte key for AES-256-GCM field encryption (base64 or hex).
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# Optional. Without it, AI features fall back to deterministic heuristics.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-7

# --- Billing (optional) -----------------------------------------------------
STRIPE_SECRET_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000
