// Aurelia — AI-native multi-tenant Event Operating System
// Canonical data model. Provider: PostgreSQL.
//
// Multi-tenancy model: every tenant-owned row carries `organizationId`.
// Application code MUST scope all reads/writes by the caller's organization
// (see src/lib/tenant.ts). There is no cross-organization data exposure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum OrgType {
  COMPANY // B2B: event company / agency
  INDIVIDUAL // B2C: single planner / host
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  type         OrgType          @default(COMPANY)
  industry     String?
  tier         SubscriptionTier @default(STARTER)
  // Billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  // Monthly AI usage accounting (resets per billing cycle)
  aiCreditsUsed  Int @default(0)
  aiCreditsLimit Int @default(100)
  // Data-moat consent: org explicitly opts in to anonymized aggregate analytics.
  analyticsOptIn Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  roles           Role[]
  events          Event[]
  venues          Venue[]
  vendors         Vendor[]
  guests          Guest[]
  financialRecords FinancialRecord[]
  tables          EventTable[]
  tasks           Task[]
  itineraries     Itinerary[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  consentRecords  ConsentRecord[]

  @@index([tier])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  // Encrypted at the field level (AES-256-GCM). Stored as ciphertext.
  phoneEnc       String?
  passwordHash   String
  roleId         String?
  role           Role?    @relation(fields: [roleId], references: [id])
  isOrgAdmin     Boolean  @default(false)
  // Optional 2FA (TOTP) — encrypted secret.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecretEnc String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  assignedTasks  Task[]      @relation("TaskAssignee")

  // Email is unique *within* an organization, not globally — same person can
  // belong to multiple orgs with the same email.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
}

// RBAC: roles are org-scoped and carry a JSON map of granular,
// per-workflow-step permissions (see src/lib/auth/rbac.ts).
model Role {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean  @default(false) // built-in roles cannot be deleted
  // permissions shape: { "<resource>": ["read","create","update","delete"], ... }
  permissions    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Refresh-token rotation: each issued refresh token is persisted (hashed).
// Rotation revokes the prior token and chains via replacedById.
model RefreshToken {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique // sha-256 of the opaque token
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdByIp    String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Inventory: venues & vendors
// ---------------------------------------------------------------------------

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  city           String?
  capacity       Int?
  basePrice      Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  amenities      String[] @default([])
  // Free-text/structured description used for embedding-based matching.
  description    String?
  // Vector embedding (stored as float array; pgvector can be layered on later).
  embedding      Float[]  @default([])
  floorPlans     FloorPlan[]
  events         Event[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, capacity])
  @@index([organizationId, city])
}

enum VendorType {
  CATERING
  PHOTOGRAPHY
  FLORAL
  AV
  ENTERTAINMENT
  DECOR
  TRANSPORT
  STAFFING
  OTHER
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           VendorType @default(OTHER)
  // Encrypted: vendor contract / pricing notes are commercially sensitive.
  contactEnc     String?
  contractEnc    String?
  typicalPrice   Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  rating         Float?
  availability   Json     @default("{}") // { "2026-06-01": true, ... }
  description    String?
  embedding      Float[]  @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
}

model FloorPlan {
  id             String   @id @default(cuid())
  organizationId String
  venueId        String?
  venue          Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileKey        String   // object-storage key (S3-equivalent)
  fileName       String
  // Extracted layout metadata (from PDF vision parsing).
  layoutMeta     Json     @default("{}")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([venueId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Events & workflow
// ---------------------------------------------------------------------------

enum EventType {
  WEDDING
  CORPORATE
  GALA
  CONFERENCE
  SOCIAL
  OTHER
}

enum EventStatus {
  DRAFT
  PLANNING
  CONFIRMED
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

// The 8-step wizard. `currentStep` lets a user resume an in-progress event.
enum WorkflowStep {
  VENUE // Step 1
  FINANCIALS // Step 2
  FLOOR_PLANS // Step 3
  WORKSPACE // Step 4
  RSVPS // Step 5
  TABLE_PLANNING // Step 6
  ITINERARY // Step 7
  CLOSURE // Step 8
}

model Event {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           EventType   @default(OTHER)
  status         EventStatus @default(DRAFT)
  currentStep    WorkflowStep @default(VENUE)
  startDate      DateTime?
  endDate        DateTime?
  expectedGuests Int?
  budget         Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  location       String?
  venueId        String?
  venue          Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  // Free-form wizard state (per-step drafts that don't warrant their own table yet).
  wizardState    Json     @default("{}")
  // Closure
  closedAt       DateTime?
  autoCloseAt    DateTime? // set to startDate/endDate + 5 days
  archivedAt     DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guests         Guest[]
  financialRecords FinancialRecord[]
  tables         EventTable[]
  tasks          Task[]
  itineraries    Itinerary[]
  floorPlans     FloorPlan[]
  postEventReport PostEventReport?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
}

// ---------------------------------------------------------------------------
// Guests & RSVPs
// ---------------------------------------------------------------------------

enum RsvpStatus {
  PENDING
  YES
  NO
  MAYBE
  AMBIGUOUS
}

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  // Encrypted PII: contact details.
  emailEnc       String?
  phoneEnc       String?
  rsvpStatus     RsvpStatus @default(PENDING)
  // Sensitive personal data — encrypted at field level.
  dietaryEnc     String?
  // Raw inbound reply text retained for AI classification & audit.
  lastReplyText  String?
  // Grouping logic for seating (e.g. "bride-side", "engineering-team").
  groupTag       String?
  seatRank       Int?     // corporate hierarchy hint (lower = more senior)
  plusOnes       Int      @default(0)
  tableId        String?
  table          EventTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([eventId, rsvpStatus])
}

// ---------------------------------------------------------------------------
// Financials
// ---------------------------------------------------------------------------

enum FinancialCategory {
  VENUE
  CATERING
  STAFFING
  AV
  DECOR
  ENTERTAINMENT
  TRANSPORT
  MARKETING
  CONTINGENCY
  OTHER
}

model FinancialRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category       FinancialCategory @default(OTHER)
  label          String
  // Encrypted monetary detail (string ciphertext of the numeric value).
  // A plaintext rounded `amountBucket` is kept for indexing/aggregation only.
  amountEnc      String
  amountBucket   Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  isPredicted    Boolean  @default(false)
  // AI confidence for predicted line items [0..1].
  confidence     Float?
  isRisk         Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([eventId, category])
}

// ---------------------------------------------------------------------------
// Seating / table planning
// ---------------------------------------------------------------------------

model EventTable {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  capacity       Int      @default(8)
  shape          String   @default("round")
  positionX      Float?
  positionY      Float?
  isLocked       Boolean  @default(false)
  guests         Guest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Workspace: tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Task {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Int      @default(2) // 1=high,2=med,3=low
  dueDate        DateTime?
  assigneeId     String?
  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([assigneeId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Itinerary
// ---------------------------------------------------------------------------

model Itinerary {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String   @default("Day-of schedule")
  // Ordered schedule items: [{ time, title, durationMin, owner, notes }]
  items          Json     @default("[]")
  menu           Json     @default("[]")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Post-event intelligence
// ---------------------------------------------------------------------------

model PostEventReport {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetVariance Json     @default("{}") // { planned, actual, variancePct, byCategory }
  attendanceRate Float?
  vendorPerformance Json  @default("[]")
  summary        String?  // AI-generated narrative
  suggestions    String[] @default([])
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Compliance: audit logs & consent
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  FINANCIAL_CHANGE
  EXPORT
  DATA_DELETION
  CONSENT_CHANGE
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  resource       String   // e.g. "event", "financialRecord", "role"
  resourceId     String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, resource])
  @@index([createdAt])
}

// GDPR consent tracking (per subject, per purpose).
model ConsentRecord {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType    String   // "user" | "guest"
  subjectId      String
  purpose        String   // "ai_training" | "marketing" | "analytics"
  granted        Boolean
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, subjectType, subjectId])
}
